# ═══════════════════════════════════════════════════════════════
# 多环境配置说明
# ═══════════════════════════════════════════════════════════════
# 不再使用单一的 .env 文件。按环境分别维护：
#   .env.local  — 本地开发（docker-compose 本地 PG/Redis/MinIO）
#   .env.dev    — 开发环境（远程 PostgreSQL，其余服务视情况配）
#   .env.prod   — 生产环境（待定，建议由容器编排注入而非文件）
#
# 启动时通过 ZHILV_ENV 环境变量切换：
#   ZHILV_ENV=local uv run uvicorn cogni_agent.main:app     # 本地
#   ZHILV_ENV=dev   uv run uvicorn cogni_agent.main:app     # 开发环境
#
# 复制此文件为 .env.local 或 .env.dev 并填入真实值；
# .env.* 文件不提交代码仓库（已在 .gitignore 中排除）。
# ═══════════════════════════════════════════════════════════
#
# ── 必填(缺了服务起不来)──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zhilv
POSTGRES_USER=zhilv
POSTGRES_PASSWORD=change_me

JWT_SECRET=change_this_to_a_random_long_string

# 凭证库主密钥。生成:python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必须配真实值——不能静默用临时密钥,否则每次重启都会导致已加密的工具凭证/模型 Key 永久无法解密。
CREDENTIAL_FERNET_KEY=change_this_44_char_urlsafe_base64_fernet_key

# ── 可选(不配也能跑,缺失时相关功能自动跳过)────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis 只用于限流、幂等键、跨实例 SSE 中转。单实例部署不配也能跑。

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# 仅向量知识的原始文件存储需要。不配时退回本地磁盘。

SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
# 仅在 user_center.require_sms_on_first_login=true 且要真发短信时需要。
# 默认关闭,不配完全没影响。

# ── 大模型 API Key:**推荐在页面上配,不用动这里** ───────────────────────
# 「系统设置 · 模型与预算」里添加模型即可,密钥加密存库、可随时切换默认模型,
# 改完立即生效不用重启。下面这些只是给「不想用页面」的部署留的兜底路径。
# 留空时,config.yaml 里对应的模型条目会被自动跳过,不会出现在可选模型里。
# WEBSEARCH_API_KEY 同理:网络知识的搜索引擎密钥现在也能在
# 「知识中心 · 网络知识」页面维护(加密存库,优先级高于这里)。

# ─────────────────────────────────────────────────────────────────────
# 以下全部【可选】。留空或整行删掉都不影响启动。
#
# 推荐做法:**不要在这里配**,起服务后到页面上维护:
#   - 大模型 API Key -> 系统中心 · 模型与预算(可加多个模型,并「设为默认」)
#   - 搜索引擎 Key   -> 知识中心 · 网络知识
# 页面维护的密钥以 Fernet 加密存库、接口不回显明文,且改完立即生效不用重启;
# 写在这里则要登服务器改文件 + 重启,多实例部署还得每台都改。
#
# 这里保留只是作为兜底:数据库里没有对应配置时才会读它们。
# ─────────────────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# WEBSEARCH_API_KEY=

# ── 文档驱动 Agent 生成器:管理后台自动化创建账号 ────────────────────────
# 供「文档驱动Agent生成器」skill 的 python 工具读取,经 config.yaml
# tool_center.sandbox.python_env_passthrough 显式放行。
# 账号密码均不硬编码进工具脚本,由部署方在此注入。
# COGNI_ADMIN_BASE_URL=http://localhost:8000
# COGNI_ADMIN_BOT_PHONE=<账号>
# COGNI_ADMIN_BOT_PASSWORD=change_me

# ── 集成测试账号（仅本地手动运行 tests/ 下脚本时使用）───────────────────
# 涉及真实登录的集成测试脚本（如 test_admin_api_comparison.py、
# test_env_comparison.py、test_apiresponse_wrapping_migration.py、
# test_apiresponse_migration_full.py）均从环境变量读取测试账号,
# 不硬编码;未配置时脚本会提示或自动跳过,dev/prod 环境不会执行这些测试。
# TEST_ACCOUNT=<账号>
# TEST_PASSWORD=<密码>
# COGNI_AGENT_ACCOUNT=<账号>
# COGNI_AGENT_PASSWORD=<密码>

# ── 工具中心 · Quick BI 智能小Q(可选)──────────────────────────────────────
# 配了 QUICKBI_USER_TOKEN 就会出现一个只读的「环境变量默认连接」(id=env-default)。
# api_key/api_secret:Quick BI 控制台 → 右上角头像 →「一键复制 skill 配置」。
QUICKBI_SERVER_DOMAIN=https://bi.aliyun.com
QUICKBI_API_KEY=
QUICKBI_API_SECRET=
QUICKBI_USER_TOKEN=
# 试用凭证(可选):只有 user_token、没有 api_key/api_secret 时用于签名
QUICKBI_TRIAL_API_KEY=
QUICKBI_TRIAL_API_SECRET=

# 数据平台开放接口的 key(xpftkey)。两处在用:
#   - 内置工具 sys_quickbi_link(Quick BI 跑不通时取 BI 看板地址);
#   - 数据指标接口的 30 个 HTTP 工具:请求头里写的是占位 {{data_platform_key}},
#     调用时从这里取(config.yaml → tool_center.secrets.data_platform_key)。
# 工具配置里**不存**这把 key。不填的话这些工具调用时会明确报「密钥未配置」,
# 同步脚本 scripts/sync_data_api_tools.py 也会拒绝 --apply。需联系数据平台开发获取。
DATA_PLATFORM_XPFTKEY=
# 数据平台地址:启动时自动建的数据指标接口工具用它替换文档里的测试环境地址。
# 留空 = https://data.12301dev.com(文档原值);生产请填正式地址。
DATA_PLATFORM_BASE_URL=
